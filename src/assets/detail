        });
    }
});
/// for edit Control Account
app.put("/api/control-accounts/:id", async (req, res) => {

    try {

        const { id } = req.params;

        const {
            hoa,
            controlaccount
        } = req.body;


        if (!hoa) {

            return res.status(400).json({
                success: false,
                message: "HOA is required."
            });

        }


        if (!controlaccount || !controlaccount.trim()) {

            return res.status(400).json({
                success: false,
                message: "Control Account Name is required."
            });

        }


        const sql = `
            UPDATE controlaccounts

            SET
                hoa_id = ?,
                ControlAccountName = ?

            WHERE ControlAccountID = ?
        `;


        const [result] = await db.query(
            sql,
            [
                hoa,
                controlaccount.trim(),
                id
            ]
        );


        if (result.affectedRows === 0) {

            return res.status(404).json({
                success: false,
                message: "Control Account not found."
            });

        }


        res.json({
            success: true,
            message: "Control Account Updated Successfully."
        });


    } catch (error) {

        console.error(
            "CONTROL ACCOUNT UPDATE ERROR:",
            error
        );


        res.status(500).json({
            success: false,
            message: error.message
        });

    }

});
